{
  "name": "@indxjp/jevlint",
  "version": "0.2.6",
  "description": "A model-based linter: ranks every file in your repo by what to refactor first, using AST metrics and decision models.",
  "keywords": [
    "linter",
    "code-quality",
    "refactoring",
    "ast",
    "decision-model",
    "jev",
    "cli"
  ],
  "license": "MIT",
  "repository": "github:INDXDev/jevlint",
  "type": "module",
  "bin": {
    "jevlint": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "presets"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "build": "tsdown",
    "dev": "node src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "demo": "vhs docs/assets/demo/demo.tape",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepublishOnly": "pnpm check"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.135",
    "@ai-sdk/openai": "^4.0.108",
    "@ai-sdk/typesafe-ai": "^3.0.33",
    "@ast-grep/napi": "^0.51.1",
    "@clack/prompts": "^1.8.1",
    "ai": "^7.0.162",
    "citty": "^0.2.2",
    "clipboardy": "^5.3.2",
    "diff": "^9.0.0",
    "ignore": "^7.0.14",
    "p-limit": "^7.3.3",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.9.1",
    "tinyglobby": "^0.2.17",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ast-grep/lang-go": "^0.0.6",
    "@ast-grep/lang-python": "^0.0.6",
    "@ast-grep/lang-rust": "^0.0.7",
    "@biomejs/biome": "^2.6.5",
    "@types/node": "^26.6.6",
    "tsdown": "^0.23.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@ast-grep/lang-go",
      "@ast-grep/lang-python",
      "@ast-grep/lang-rust"
    ]
  }
}
